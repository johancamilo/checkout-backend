# Server
PORT=3000

# AWS / DynamoDB
AWS_REGION=us-east-1
# Leave DYNAMODB_ENDPOINT unset when running against real AWS DynamoDB.
# Set it to http://localhost:8000 if you run DynamoDB Local for development.
DYNAMODB_ENDPOINT=http://localhost:8000
PRODUCTS_TABLE=Products
TRANSACTIONS_TABLE=Transactions
CUSTOMERS_TABLE=Customers
DELIVERIES_TABLE=Deliveries

# Payment  Sandbox (UAT) - values from the test brief
PAYMENT_GATEWAY_BASE_URL=https://api-sandbox.example-provider.dev/v1
PAYMENT_GATEWAY_PUBLIC_KEY=your_public_key_here
PAYMENT_GATEWAY_PRIVATE_KEY=your_private_key_here
PAYMENT_GATEWAY_INTEGRITY_SECRET=your_integrity_secret_here
